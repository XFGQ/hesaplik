[Unit]
Description=Hesaplık - veritabanı yedeğini admin'in Telegram'ına gönder
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=hesaplik
WorkingDirectory=/opt/hesaplik
# docker compose üretim yığınındaki db'yi hedeflesin: deploy yığını
# `-f docker-compose.prod.yml` ile kurar, varsayılan docker-compose.yml değil.
Environment=COMPOSE_FILE=docker-compose.prod.yml
ExecStart=/opt/hesaplik/scripts/telegram-yedek.sh
# curl deneme başına 300 sn, 3 yeniden deneme; büyük dosyada yavaş hat payı.
TimeoutStartSec=1800
