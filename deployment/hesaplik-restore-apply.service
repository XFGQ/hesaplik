[Unit]
Description=Hesaplık - bekleyen geri yükleme isteğini uygula
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=hesaplik
WorkingDirectory=/opt/hesaplik
ExecStart=/opt/hesaplik/scripts/restore-apply.sh
# Geri yükleme büyük veritabanında uzun sürebilir; yarıda kesilmesi
# pg_restore --clean sonrası yarım şema bırakır.
TimeoutStartSec=1800
