POSTGRES_USER=hesaplik
POSTGRES_PASSWORD=degistir-bu-parolayi
POSTGRES_DB=hesaplik

DATABASE_URL=postgresql+asyncpg://hesaplik:degistir-bu-parolayi@localhost:5432/hesaplik
TEST_DSN=postgresql+asyncpg://hesaplik:degistir-bu-parolayi@localhost:5432/hesaplik_test

DOMAIN=localhost
LOG_LEVEL=info

# Yerelde varsayılan: ./data/backups. Üretimde 3-2-1 kuralı için
# CLAUDE.md > "Canlıya alırken yapılacaklar" bölümüne bakın.
RESTIC_REPOSITORY=./data/backups
RESTIC_PASSWORD=degistir-bu-parolayi-da

# Saklama politikası. 5 dakikada bir yedek alınıyor; --keep-last 288 son
# 24 saatin tüm 5-dakikalık yedeklerini korur (24*60/5). Değiştirmeden
# önce CLAUDE.md > "Yedekleme saklama politikası" bölümüne bakın.
RESTIC_KEEP_LAST=288
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=12
RESTIC_KEEP_MONTHLY=12

# Telegram bot. Token yoksa bot başlamaz ama API çalışmaya devam eder.
# TELEGRAM_ADMIN_IDS: virgülle ayrılmış chat_id listesi (örn. 123456,789012).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# LLM fallback (Faz 4). Kural parser çözemediği cümleler için devreye
# girer, kural parser kaldırılmaz. LLM_PROVIDER=none ile tamamen kapatılır
# (Ollama kurulu değilse/erişilemezse sistem yine çökmez, kural parser +
# "elle gir" ile çalışmaya devam eder).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# İşlemcide model ~9 sn/cümle sürüyor; üstüne Ollama modeli bellekten
# düşürüp ilk istekte yeniden yüklerse (soğuk başlangıç) süre 60 sn'yi
# aşabilir. Bot başlangıcında ısınma çağrısı yapılır ama pay için 90.
# GPU (vLLM) gelince küçültülebilir.
LLM_TIMEOUT=90
