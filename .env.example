POSTGRES_USER=hesaplik
POSTGRES_PASSWORD=degistir-bu-parolayi
POSTGRES_DB=hesaplik

DATABASE_URL=postgresql+asyncpg://hesaplik:degistir-bu-parolayi@localhost:5432/hesaplik
TEST_DSN=postgresql+asyncpg://hesaplik:degistir-bu-parolayi@localhost:5432/hesaplik_test

DOMAIN=localhost
LOG_LEVEL=info

# Giriş (tek hesap, JWT). Üçü de BOŞSA sistem tamamen kapalıdır: giriş
# reddedilir, defter + admin uçlarının tümü 401 döner. Şifre düz metin
# DEĞİL, bcrypt hash olarak durur. Hash üretmek için:
#   .venv/bin/python -c "import bcrypt; print(bcrypt.hashpw(b'sifreniz', bcrypt.gensalt()).decode())"
# JWT_SECRET için (uzun/rastgele, üretimde şart):
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET değiştirilince tüm açık oturumlar kendiliğinden geçersiz olur.
#
# UYARI (yalnızca docker-compose ile üretim deploy'unda): bcrypt hash'i
# `$` karakteri içerir (ör. $2b$12$...). docker-compose .env dosyasını
# kendi içinde de değişken ikamesi için tarar — `$` işaretlerini doğrudan
# yazarsanız sessizce boşa "ikame edilir" ve hash bozulur (yalnızca
# login'i başarısız yapar, güvenlik açığı DEĞİL — fail-closed). Bu yüzden
# docker-compose'a giden .env'de her `$`'ı `$$` yaparak escape edin.
# Yerel `just dev`/`just api` (uvicorn .env'i doğrudan okur, docker
# compose'un ikamesinden GEÇMEZ) buna gerek duymaz, hash'i olduğu gibi
# yazabilirsiniz.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=
# Token ömrü (saat). Süre dolunca yeniden giriş istenir.
JWT_EXPIRE_HOURS=24

# Yerelde varsayılan: ./data/backups. Üretimde 3-2-1 kuralı için
# CLAUDE.md > "Canlıya alırken yapılacaklar" bölümüne bakın.
RESTIC_REPOSITORY=./data/backups
RESTIC_PASSWORD=degistir-bu-parolayi-da

# Saklama politikası. 5 dakikada bir yedek alınıyor; --keep-last 288 son
# 24 saatin tüm 5-dakikalık yedeklerini korur (24*60/5). Değiştirmeden
# önce CLAUDE.md > "Yedekleme saklama politikası" bölümüne bakın.
RESTIC_KEEP_LAST=288
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=12
RESTIC_KEEP_MONTHLY=12

# Telegram bot. Token yoksa bot başlamaz ama API çalışmaya devam eder.
# TELEGRAM_ADMIN_IDS: virgülle ayrılmış chat_id listesi (örn. 123456,789012).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# TELEGRAM_ADMIN_CHAT_ID: veritabanı yedeğinin (scripts/telegram-yedek.sh,
# her gün 04:00 ve 06:00) gönderileceği KİŞİSEL chat id — tek sayı.
# Bulmak için: Telegram'da @userinfobot'a herhangi bir mesaj yazın, cevaptaki
# "Id: 123456789" sayısını buraya yazın. Ayrıca kendi botunuza bir kez /start
# yazın: bot, kendisiyle hiç konuşmamış birine mesaj gönderemez.
# Boşsa Telegram yedeği gönderilmez (restic disk yedeği etkilenmez).
TELEGRAM_ADMIN_CHAT_ID=
# ACILIS_BILDIRIMI: true ise API her başladığında (deploy, sunucu yeniden
# başlatma) TELEGRAM_ADMIN_CHAT_ID'ye "🚀 Sistem ayağa kalktı" + /durum raporu
# gider. Yerelde false bırakın (--reload her kayıtta yeniden başlatır);
# docker-compose.prod.yml varsayılan olarak true yapar.
ACILIS_BILDIRIMI=false

# LLM fallback (Faz 4). Kural parser çözemediği cümleler için devreye
# girer, kural parser kaldırılmaz. LLM_PROVIDER=none ile tamamen kapatılır
# (Ollama kurulu değilse/erişilemezse sistem yine çökmez, kural parser +
# "elle gir" ile çalışmaya devam eder).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# İşlemcide model ~9 sn/cümle sürüyor; üstüne Ollama modeli bellekten
# düşürüp ilk istekte yeniden yüklerse (soğuk başlangıç) süre 60 sn'yi
# aşabilir. Bot başlangıcında ısınma çağrısı yapılır ama pay için 90.
# GPU (vLLM) gelince küçültülebilir.
LLM_TIMEOUT=90

# NVIDIA NIM (bulut, Faz 4c) — DÖRDÜNCÜ ve EN ÖNCELİKLİ LLM katmanı.
# OpenAI uyumlu API: {NVIDIA_URL}/chat/completions. NVIDIA_API_KEY BOŞ ise
# NVIDIA hiç denenmez, sistem vLLM/Ollama/none'a düşer. Rate limit
# (40 istek/dk) dolarsa (429) otomatik bir sonraki katmana (vLLM) düşülür.
NVIDIA_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen2.5-72b-instruct

# Groq STT (Faz 5 — sesli komut). Telegram sesli mesajı (.ogg) doğrudan
# Groq'un OpenAI-uyumlu /audio/transcriptions ucuna gönderilir. GROQ_API_KEY
# BOŞ ise sesli mesaj desteği tamamen kapalıdır — kullanıcıdan yazması
# istenir, sistem çökmez.
GROQ_API_KEY=
GROQ_STT_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_TIMEOUT=30

# vLLM uzaktan aç/kapat ("Yol B"). Panel (/admin > LLM Yönetimi) DB'ye bir
# tercih yazar (vllm_desired); Bosna'daki host script'i
# (scripts/vllm-control.sh) bu değeri GET /api/vllm-desired ile ÇEKER ve
# uygular. Bu token o ucu korur — giriş hesabından AYRI, yalnızca bu tek
# uca erişim yetkisi verir (sunucu-sunucu çağrısı, kullanıcı oturumu değil).
# BOŞ bırakılırsa uç her zaman 401 döner.
VLLM_CONTROL_TOKEN=
