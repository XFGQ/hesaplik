{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    /* goods.ts, node --test tarafından da doğrudan çalıştırılır (DOM'suz
       mantık); Node açık ".ts" uzantısı ister. Bundler + noEmit olduğu için
       zararsız. */
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  /* Test dosyaları Node'un kendi koşucusuyla çalışır (node --test src/lib/...);
     tip denetimine girmezler, node:test tipleri kurulu değil. */
  "exclude": ["src/**/*.test.ts"]
}
